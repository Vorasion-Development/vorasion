{
  "name": "@vorasion/repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun format --check && bun lint && bun typecheck",
    "commit": "cz",
    "format": "oxfmt",
    "lint": "oxlint",
    "orm": "bun run --env-file=./.env.local --filter @vorasion/orm orm",
    "prepare": "husky",
    "sapphire": "sapphire",
    "security": "socket scan create .",
    "update": "taze -r",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@sapphire/cli": "^1.9.3",
    "@types/bun": "^1.4",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "inquirer": "9",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "socket": "^1.1.158",
    "taze": "^21.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.0"
}
